<Window x:Class="FtPdf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações - FT PDF"
        Height="460" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F172A"
        Foreground="#F8FAFC">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Title -->
            <RowDefinition Height="Auto" />
            <!-- Content -->
            <RowDefinition Height="*" />
            <!-- Footer Buttons -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚙️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Text="Configurações do Programa" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Personalize o comportamento do leitor e atualizações do sistema." 
                       FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Main Options -->
        <StackPanel Grid.Row="1">
            <!-- Default App Section -->
            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="🖥️ Leitor de PDF Padrão do Windows" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" />
                        <TextBlock Text="Configure o FT PDF para abrir automaticamente todos os arquivos .pdf no seu computador." 
                                   FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>

                    <Button Grid.Column="1" Content="Configurar" Click="BtnSetDefaultApp_Click"
                            Background="#3B82F6" Foreground="White" FontWeight="SemiBold"
                            FontSize="11.5" Padding="12,6" Margin="10,0,0,0" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <!-- Updates / GitHub Actions Section -->
            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="🚀 Atualizações do Aplicativo" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" />
                        <TextBlock Text="Canal: GitHub Actions (Integração Contínua)&#x0a;Versão Atual: v1.0.0 (Build .NET 10)" 
                                   FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>

                    <Button Grid.Column="1" Content="Verificar" Click="BtnCheckUpdates_Click"
                            Background="#334155" Foreground="#F8FAFC" FontWeight="Medium"
                            FontSize="11.5" Padding="12,6" Margin="10,0,0,0" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <!-- Offline & Security Info -->
            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel>
                    <TextBlock Text="🔒 Privacidade e Execução Local" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" />
                    <TextBlock Text="O FT PDF é um leitor 100% nativo e offline. Nenhum dado ou arquivo é enviado para a nuvem." 
                               FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="FT PDF • Feito com C# e .NET 10" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
            <Button Content="Fechar" Click="BtnClose_Click" HorizontalAlignment="Right"
                    Background="#334155" Foreground="#F8FAFC" FontWeight="SemiBold"
                    Padding="16,6" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>
