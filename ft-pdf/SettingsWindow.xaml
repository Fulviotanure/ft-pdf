<Window x:Class="FtPdf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atualizações - FT PDF" 
        Height="360" Width="490"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F172A"
        Foreground="#F8FAFC"
        Icon="Assets/logo.png"
        Loaded="Window_Loaded">

    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/logo.png" Width="28" Height="28" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="FT PDF" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                    <Border Background="#1E3A2F" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                        <TextBlock x:Name="TxtBadgeVersion" Text="Release 2.0.0" FontSize="11" FontWeight="Bold" Foreground="#34D399" />
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Settings Content: Updates Focus -->
            <Border Grid.Row="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                <StackPanel VerticalAlignment="Center">
                    <!-- Informações de Versão -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Versão Instalada:" FontSize="12" Foreground="#94A3B8" />
                            <TextBlock x:Name="TxtCurrentVersion" Text="v2.0.0" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="Última Versão Disponível:" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Right" />
                            <TextBlock x:Name="TxtLatestVersion" Text="Verificando..." FontSize="15" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="#334155" Margin="0,0,0,14" />

                    <!-- Status e Barra de Progresso -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock x:Name="TxtStatus" Text="Verificando atualizações..." FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" />
                        <ProgressBar x:Name="PbStatus" Height="4" IsIndeterminate="True" Margin="0,8,0,0" 
                                     Background="#0F172A" Foreground="#38BDF8" BorderThickness="0" />
                    </StackPanel>

                    <!-- Botão de Ação: Atualizar Agora -->
                    <Button x:Name="BtnAction" Content="🔄 Atualizar Agora" Click="BtnAction_Click"
                            Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="13"
                            Padding="16,9" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Bottom Button -->
            <Button Grid.Row="2" Content="Fechar" Click="BtnClose_Click"
                    Background="#334155" Foreground="#F8FAFC" FontSize="12.5" FontWeight="SemiBold"
                    Padding="18,7" HorizontalAlignment="Right" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Border>
</Window>
