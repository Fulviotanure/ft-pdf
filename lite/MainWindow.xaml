<Window x:Class="FtPdfLite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="FT PDF Lite - Leitor e Validador"
        Icon="Assets/logo.png"
        Height="860" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F8FAFC">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" 
                      ResizeBorderThickness="6" 
                      CornerRadius="0" 
                      GlassFrameThickness="0" 
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFileCommand}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseFileCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveFileCommand}" />
    </Window.InputBindings>

    <Grid Background="#0F172A">
        <Grid.RowDefinitions>
            <!-- Integrated Custom Titlebar with Tabs (Height: 38) -->
            <RowDefinition Height="38" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== CUSTOM INTEGRATED TITLEBAR ==================== -->
        <Border Grid.Row="0" Background="#0A0F1D" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: Brand Logo & App Name -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Center: Integrated Tabs Strip -->
                    <ColumnDefinition Width="*" />
                    <!-- Right: Custom Window Controls (Min, Max, Close) -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Branding with Classic Blue F Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,8,0">
                    <Image Source="Assets/logo.png" Width="20" Height="20" Margin="0,0,8,0" 
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="FT PDF" FontSize="12.5" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                    <Border Background="#1E3A2F" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="5,1.5" Margin="6,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="LITE" FontSize="9.5" FontWeight="ExtraBold" Foreground="#34D399" />
                    </Border>
                </StackPanel>

                <!-- Center: Seamless Document Tabs Strip -->
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Dynamic Document Tabs -->
                        <StackPanel x:Name="PanelTabs" Orientation="Horizontal" VerticalAlignment="Center" />

                        <!-- Add Tab Button -->
                        <Button x:Name="BtnNewTab" Content="➕ Nova Aba" Click="BtnOpenFile_Click"
                                Background="Transparent" Foreground="#64748B" FontSize="11.5" FontWeight="Medium"
                                Padding="8,4" Margin="2,0,0,0" BorderThickness="0" Cursor="Hand"
                                ToolTip="Abrir outro documento PDF em uma nova aba">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="4" /></Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Right: Custom Integrated Window Controls (Minimize, Maximize, Close) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Minimize Button -->
                    <Button x:Name="BtnMinimize" Content="🗕" Click="BtnMinimize_Click"
                            Width="44" Background="Transparent" Foreground="#94A3B8" FontSize="12"
                            BorderThickness="0" Cursor="Hand" ToolTip="Minimizar">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#1E293B" />
                                                    <Setter Property="Foreground" Value="#F8FAFC" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Maximize / Restore Button -->
                    <Button x:Name="BtnMaximize" Content="🗖" Click="BtnMaximize_Click"
                            Width="44" Background="Transparent" Foreground="#94A3B8" FontSize="12"
                            BorderThickness="0" Cursor="Hand" ToolTip="Maximizar / Restaurar">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#1E293B" />
                                                    <Setter Property="Foreground" Value="#F8FAFC" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Close Button -->
                    <Button x:Name="BtnCloseWindow" Content="✕" Click="BtnCloseWindow_Click"
                            Width="46" Background="Transparent" Foreground="#94A3B8" FontSize="13"
                            BorderThickness="0" Cursor="Hand" ToolTip="Fechar">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#E11D48" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== MAIN CONTENT ROW ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Sidebar: Core Actions (Width: 60) -->
                <ColumnDefinition Width="60" />
                <!-- Center: Native Vector Document Viewer Area -->
                <ColumnDefinition Width="*" MinWidth="350" />
                <!-- Splitter for Validation Panel -->
                <ColumnDefinition Width="Auto" />
                <!-- Right: Validation & Notepad Panel -->
                <ColumnDefinition x:Name="ColNotepad" Width="0" MaxWidth="900" />
            </Grid.ColumnDefinitions>

            <!-- ==================== LEFT SIDEBAR: CORE ACTIONS ONLY ==================== -->
            <Border Grid.Column="0" Background="#0A0F1D" BorderBrush="#1E293B" BorderThickness="0,0,1,0">
                <Grid Margin="0,10">
                    <Grid.RowDefinitions>
                        <!-- Top actions: Open, Save, Copy, Validate -->
                        <RowDefinition Height="*" />
                        <!-- Bottom tool: Settings -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Core Document Actions -->
                    <StackPanel Grid.Row="0">
                        <!-- Open File -->
                        <Button x:Name="BtnOpenFile" Content="📂" ToolTip="Abrir Arquivo PDF (Ctrl+O)" Click="BtnOpenFile_Click"
                                Width="44" Height="44" Margin="0,0,0,8" Background="#1E293B" Foreground="#38BDF8" 
                                FontSize="18" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style>
                            </Button.Resources>
                        </Button>

                        <!-- Quick Save Copy -->
                        <Button x:Name="BtnQuickSave" Content="💾" ToolTip="Salvar Cópia do PDF (Ctrl+S)" Click="BtnQuickSave_Click"
                                Width="44" Height="44" Margin="0,0,0,8" Background="#1E293B" Foreground="#34D399" 
                                FontSize="18" BorderThickness="0" Cursor="Hand" Visibility="Collapsed">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style>
                            </Button.Resources>
                        </Button>

                        <!-- Quick Copy Formatted Text -->
                        <Button x:Name="BtnQuickCopy" Content="📋" ToolTip="Copiar Texto Formatado" Click="BtnQuickCopy_Click"
                                Width="44" Height="44" Margin="0,0,0,8" Background="#1E293B" Foreground="#A78BFA" 
                                FontSize="18" BorderThickness="0" Cursor="Hand" Visibility="Collapsed">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style>
                            </Button.Resources>
                        </Button>

                        <!-- Validate / Diagnostics Button -->
                        <Button x:Name="BtnToggleNotepad" Content="🔍" ToolTip="Validar Integridade e Bloco de Notas" Click="BtnToggleNotepad_Click"
                                Width="44" Height="44" Margin="0,0,0,8" Background="#1E293B" Foreground="#FACC15" 
                                FontSize="18" BorderThickness="0" Cursor="Hand" Visibility="Collapsed">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>

                    <!-- Settings (Bottom) -->
                    <StackPanel Grid.Row="1">
                        <Rectangle Height="1" Fill="#1E293B" Margin="8,4,8,8" />
                        <Button x:Name="BtnSettings" Content="⚙️" ToolTip="Configurações (Leitor Padrão e Atualizações)" Click="BtnSettings_Click"
                                Width="44" Height="44" Background="#1E293B" Foreground="#94A3B8" 
                                FontSize="18" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== CENTER: VIEWER & EMPTY STATE ==================== -->
            <Grid Grid.Column="1" Background="#0F172A">
                <!-- Empty State (When no documents are open) -->
                <Grid x:Name="PanelEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel MaxWidth="460" HorizontalAlignment="Center">
                        <Border Width="88" Height="88" CornerRadius="22" Background="#131D31" 
                                BorderBrush="#334155" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <Image Source="Assets/logo.png" Width="68" Height="68" 
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>

                        <TextBlock Text="FT PDF Lite" FontSize="20" FontWeight="Bold" 
                                   Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        
                        <TextBlock Text="Leitor e validador ultraleve. Abra um arquivo PDF para leitura vetorial nativa e diagnóstico instantâneo de integridade." 
                                   Foreground="#94A3B8" FontSize="13" TextAlignment="Center" 
                                   TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,22" />

                        <Button Content="Selecionar Arquivo PDF" Click="BtnOpenFile_Click"
                                Background="#2563EB" Foreground="White" FontSize="13.5" FontWeight="SemiBold"
                                Padding="20,10" HorizontalAlignment="Center" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Active WebView2 Vector Viewer (Clean, Native, Hardware-Accelerated) -->
                <Grid x:Name="PanelActiveContent" Visibility="Collapsed">
                    <wv2:WebView2 x:Name="PdfWebViewer" />
                </Grid>
            </Grid>

            <!-- Grid Splitter for Resizing Validation Panel -->
            <GridSplitter Grid.Column="2" x:Name="SplitterBar" Width="5" HorizontalAlignment="Center" 
                          VerticalAlignment="Stretch" Background="#1E293B" Cursor="SizeWE" Visibility="Collapsed" />

            <!-- ==================== RIGHT: VALIDATION & NOTEPAD PANEL ==================== -->
            <Border Grid.Column="3" x:Name="PanelNotepad" Background="#0A0F1D" 
                    BorderBrush="#1E293B" BorderThickness="1,0,0,0" Visibility="Collapsed">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <!-- Panel Header (Document Type & Score) -->
                        <RowDefinition Height="Auto" />
                        <!-- Import Verdict Banner -->
                        <RowDefinition Height="Auto" />
                        <!-- Diagnostics & Properties Area -->
                        <RowDefinition Height="Auto" />
                        <!-- Text Editor -->
                        <RowDefinition Height="*" />
                        <!-- Bottom Status Bar -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header: Document Type + Integrity Badge -->
                    <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" 
                            CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="CLASSIFICAÇÃO DO ARQUIVO" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                                <TextBlock x:Name="TxtHeaderDocType" Text="Texto Vetorial Nativo" 
                                           FontSize="15" FontWeight="ExtraBold" Foreground="#10B981" 
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>

                            <Border Grid.Column="1" x:Name="BadgeIntegrity" Background="#1E3A2F" BorderBrush="#10B981" BorderThickness="1" 
                                    CornerRadius="8" Padding="10,6" Margin="8,0,8,0" VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtIntegrityScore" Text="100% Integridade" 
                                               FontSize="12" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="TxtIntegrityStatusText" Text="Alta Integridade" 
                                               FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Button Grid.Column="2" Content="✕" Click="BtnCloseNotepad_Click"
                                    Width="26" Height="26" Background="Transparent" Foreground="#94A3B8" 
                                    BorderThickness="0" Cursor="Hand" ToolTip="Recolher Painel" />
                        </Grid>
                    </Border>

                    <!-- Import Verdict Banner -->
                    <Border Grid.Row="1" x:Name="BorderImportVerdict" Background="#1E3A2F" BorderBrush="#10B981" BorderThickness="1.5" 
                            CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtImportVerdictIcon" Text="✅" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtImportVerdict" Text="O arquivo importa" 
                                       FontSize="13" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Expandable Properties & Diagnostics Section -->
                    <Border Grid.Row="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" 
                            CornerRadius="8" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="TxtDiagStrangeChars" Text="Sinais Estranhos: 0" 
                                               FontSize="11.5" Foreground="#E2E8F0" FontWeight="SemiBold" />
                                    <TextBlock x:Name="TxtDiagFormatting" Text="Formatação: Bem Formatado" 
                                               FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="TxtDiagImages" Text="Imagens / Scans: 0" 
                                               FontSize="11.5" Foreground="#E2E8F0" FontWeight="SemiBold" />
                                    <TextBlock x:Name="TxtDiagCharCount" Text="Total de Caracteres: 0" 
                                               FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="TxtDiagWarning" Text="Texto analisado com alta integridade." 
                                       FontSize="11" Foreground="#60A5FA" TextWrapping="Wrap" Margin="0,0,0,8" />

                            <Expander x:Name="ExpanderProps" Header="ℹ️ Propriedades do Documento" 
                                      Foreground="#94A3B8" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,8">
                                <Border Background="#131D31" BorderBrush="#334155" BorderThickness="1" 
                                        CornerRadius="6" Padding="8" Margin="0,4,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Tamanho:" Foreground="#64748B" FontSize="11" Margin="0,1" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtPropFileSize" Text="-" Foreground="#E2E8F0" FontSize="11" Margin="0,1" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Versão PDF:" Foreground="#64748B" FontSize="11" Margin="0,1" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtPropPdfVersion" Text="-" Foreground="#E2E8F0" FontSize="11" Margin="0,1" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Dimensões:" Foreground="#64748B" FontSize="11" Margin="0,1" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtPropDimensions" Text="-" Foreground="#E2E8F0" FontSize="11" Margin="0,1" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Orientação:" Foreground="#64748B" FontSize="11" Margin="0,1" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtPropOrientation" Text="-" Foreground="#E2E8F0" FontSize="11" Margin="0,1" />

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Autor / Produtor:" Foreground="#64748B" FontSize="11" Margin="0,1" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtPropAuthorProducer" Text="-" Foreground="#E2E8F0" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1" />

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Criação:" Foreground="#64748B" FontSize="11" Margin="0,1" />
                                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="TxtPropCreationDate" Text="-" Foreground="#E2E8F0" FontSize="11" Margin="0,1" />

                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Segurança:" Foreground="#64748B" FontSize="11" Margin="0,1" />
                                        <TextBlock Grid.Row="6" Grid.Column="1" x:Name="TxtPropSecurity" Text="-" Foreground="#E2E8F0" FontSize="11" Margin="0,1" />
                                    </Grid>
                                </Border>
                            </Expander>

                            <WrapPanel Orientation="Horizontal">
                                <Button x:Name="BtnToggleRawText" Content="Exibir Texto Cru" Click="BtnToggleRawText_Click"
                                        Background="#334155" Foreground="#F8FAFC" FontSize="11" FontWeight="Medium"
                                        Padding="8,5" Margin="0,0,6,4" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="4" /></Style>
                                    </Button.Resources>
                                </Button>

                                <Button Content="📋 Copiar Tudo" Click="BtnCopyText_Click"
                                        Background="#334155" Foreground="#F8FAFC" FontSize="11" FontWeight="Medium"
                                        Padding="8,5" Margin="0,0,6,4" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="4" /></Style>
                                    </Button.Resources>
                                </Button>

                                <Button Content="💾 Salvar .txt" Click="BtnSaveTxt_Click"
                                        Background="#334155" Foreground="#F8FAFC" FontSize="11" FontWeight="Medium"
                                        Padding="8,5" Margin="0,0,6,4" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="4" /></Style>
                                    </Button.Resources>
                                </Button>

                                <Button x:Name="BtnToggleWrap" Content="Quebrar Linha: ON" Click="BtnToggleWrap_Click"
                                        Background="#334155" Foreground="#94A3B8" FontSize="11"
                                        Padding="8,5" Margin="0,0,0,4" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="4" /></Style>
                                    </Button.Resources>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Text Editor -->
                    <Border Grid.Row="3" Background="#060A14" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6">
                        <TextBox x:Name="TxtEditor" AcceptsReturn="True" AcceptsTab="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 Background="Transparent" Foreground="#E2E8F0" CaretBrush="#38BDF8"
                                 FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12.5"
                                 Padding="10" BorderThickness="0" TextChanged="TxtEditor_TextChanged" />
                    </Border>

                    <!-- Bottom Status Bar -->
                    <Grid Grid.Row="4" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TxtEditorStats" Text="Caracteres: 0 | Palavras: 0" 
                                   FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />

                        <TextBlock x:Name="TxtEditorMode" Text="Modo: Layout Preservado" 
                                   Grid.Column="1" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
