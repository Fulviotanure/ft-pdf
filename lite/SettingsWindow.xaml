<Window x:Class="FtPdfLite.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações - FT PDF Lite" 
        Height="460" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F172A"
        Foreground="#F8FAFC"
        Icon="Assets/logo.png">

    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/logo.png" Width="28" Height="28" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="FT PDF Lite" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                    <Border Background="#1E3A2F" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                        <TextBlock Text="Release 1.0.0" FontSize="11" FontWeight="Bold" Foreground="#34D399" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Configurações do sistema, leitor padrão e atualizações automáticas." 
                           FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Settings Content -->
            <StackPanel Grid.Row="1">
                <!-- Section 1: Default App -->
                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="📌 Aplicativo Padrão para Arquivos PDF" FontSize="13.5" FontWeight="SemiBold" Foreground="#F8FAFC" />
                        <TextBlock Text="Defina o FT PDF Lite como o leitor oficial do Windows para abrir documentos PDF automaticamente com dois cliques." 
                                   FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,4,0,12" />

                        <Button x:Name="BtnSetDefaultApp" Content="⚙️ Definir como Leitor Padrão no Windows" Click="BtnSetDefaultApp_Click"
                                Background="#2563EB" Foreground="White" FontWeight="SemiBold" FontSize="12"
                                Padding="14,8" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Section 2: Updates & GitHub Actions -->
                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="🚀 Atualizações Contínuas (GitHub Actions)" FontSize="13.5" FontWeight="SemiBold" Foreground="#F8FAFC" />
                        <TextBlock Text="O FT PDF Lite conta com automação de build e distribuição contínua configurada via GitHub Actions (Release 1)." 
                                   FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,4,0,12" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="🌐 Abrir Repositório no GitHub" Click="BtnOpenRepo_Click"
                                    Background="#334155" Foreground="#F8FAFC" FontSize="12" FontWeight="Medium"
                                    Padding="12,7" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style>
                                </Button.Resources>
                            </Button>

                            <Button Content="🔄 Verificar Atualizações" Click="BtnCheckUpdates_Click"
                                    Background="#334155" Foreground="#F8FAFC" FontSize="12" FontWeight="Medium"
                                    Padding="12,7" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Bottom Button -->
            <Button Grid.Row="2" Content="Fechar" Click="BtnClose_Click"
                    Background="#334155" Foreground="#F8FAFC" FontSize="13" FontWeight="SemiBold"
                    Padding="18,8" HorizontalAlignment="Right" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Border>
</Window>
